<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not rewrite requests that are already inside /public
    RewriteRule ^public/ - [L]

    # Root domain -> /public
    RewriteRule ^$ public/ [L]

    # Everything else -> /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>